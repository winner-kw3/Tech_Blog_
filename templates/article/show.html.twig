{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div>
		<h1>{{ article.titre }}</h1>
		<p>{{ article.contenu }}</p>

		<h3>Catégories :</h3>
		<ul>
			{% for cat in article.getCategories %}
				<li>{{ cat.titre }}</li>
			{% else %}
				<li>Aucune catégorie</li>
			{% endfor %}
		</ul>

		<h3>Commentaires :</h3>
        {% for comment in article.getComments %}
            <div style="margin-bottom: 1rem;">
                <p>{{ comment.contenu }}</p>
                <small>
                    Posté le
                    {{ comment.createdAt|date('d/m/Y H:i') }}
                    par
                    {{ comment.username }}
                </small>
            </div>
        {% else %}
            <p>Aucun commentaire pour le moment.</p>
        {% endfor %}
		<h3>Ajouter un commentaire</h3>
		{{ form_start(form) }}
		{{ form_widget(form) }}
		<button type="submit" class="btn btn-primary">Publier</button>
		{{ form_end(form) }}
	</div>
{% endblock %}
