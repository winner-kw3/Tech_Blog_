<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Mon Blog
			{% endblock %}
		</title>
		<style>

            body {
                background: #f8fafc;
                color: #222;
                font-family: 'Segoe UI', Arial, sans-serif;
                margin: 0;
                padding: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
            }
            .container,
            main {
                max-width: 800px;
                width: 100%;
                margin: 2rem auto;
                background: #fff;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
                padding: 2rem;
            }
            
			h1,
			h2,
			h3 {
				color: #2c3e50;
				margin-bottom: 1rem;
			}
			ul {
				padding-left: 1.2rem;
			}
			ul li {
				margin-bottom: 0.5rem;
			}
			a {
				color: #007bff;
				text-decoration: none;
				transition: color 0.2s;
			}
			a:hover {
				color: #0056b3;
				text-decoration: underline;
			}
			button,
			.btn {
				background: #007bff;
				color: #fff;
				border: none;
				border-radius: 4px;
				padding: 0.5rem 1.2rem;
				cursor: pointer;
				font-size: 1rem;
				transition: background 0.2s;
			}
			button:hover,
			.btn:hover {
				background: #0056b3;
			}
			form {
				margin-top: 1.5rem;
			}
			textarea,
			input[type="text"] {
				width: 100%;
				padding: 0.5rem;
				margin-bottom: 1rem;
				border: 1px solid #ccc;
				border-radius: 4px;
				font-size: 1rem;
			}
			small {
				color: #888;
			}
		</style>
		{% block stylesheets %}{% endblock %}
	</head>
	<body>
		<header>
			<img src="{{ asset('images/logo-tech-trendz.png') }}" alt="Logo du blog" width=200/>
			<nav>
				<a href="{{ path('home') }}">Accueil</a>
				|
				<a href="{{ path('about') }}">À propos</a>
			</nav>
		</header>

		<main>
			{% block body %}{% endblock %}
		</main>

		<footer>
			<p>© 2025 - Mon Blog</p>
		</footer>

		{% block javascripts %}{% endblock %}
	</body>
</html>

